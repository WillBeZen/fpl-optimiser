# Copy this file to .env (which git ignores) and fill in real values:
#   cp .env.example .env
# Never put a real key in this file — it is committed.

# Anthropic API key for the Claude advisor (Section 6).
ANTHROPIC_API_KEY=

# Your FPL manager/entry ID -- the number in your team URL:
# fantasy.premierleague.com/entry/<THIS_NUMBER>/event/1
# Used to read your current squad so the planner knows what to transfer FROM.
FPL_TEAM_ID=
